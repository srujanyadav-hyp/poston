                              _buildServiceCard(
                                title: "The Ridgewood Apartment",
                                location: "Aspen, Colorado",
                                imageUrl: "https://assets.prebuiltui.com/images/components/card/card-houseImage1.png",
                              ),
                            ],
                          ),
